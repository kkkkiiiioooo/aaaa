{
  "name": "Windows 11 Pro + KasmVNC + desktop-lite",
  "service": "desktop",
  "dockerComposeFile": "codespaces.yml",
  "workspaceFolder": "/workspaces/windows",
  "overrideCommand": false,
  "remoteUser": "root",
  "forwardPorts": [3000, 3001, 6080, 5901, "windows:8006"],
  "portsAttributes": {
    "3000": { "label": "KasmVNC http (nginx)", "protocol": "http", "onAutoForward": "notify" },
    "3001": { "label": "KasmVNC https (nginx)", "protocol": "https" },
    "6080": { "label": "desktop-lite noVNC", "protocol": "http" },
    "5901": { "label": "desktop-lite TigerVNC" },
    "windows:8006": { "label": "Windows (dockur)", "protocol": "http" }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "initializeCommand": "docker system prune --all --force"
}
