{
  "name": "Tiny11 Core",
  "service": "windows",
  "containerEnv": {
    "VERSION": "core11"
  },
  "forwardPorts": [6901],
  "portsAttributes": {
    "6901": {
      "label": "Web (KasmVNC)",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "dockerComposeFile": "codespaces.yml",
  "workspaceFolder": "/workspaces/windows",
  "postStartCommand": "bash /workspaces/windows/.devcontainer/setup.sh",
  "initializeCommand": "docker system prune --all --force"
}
