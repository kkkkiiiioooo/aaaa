#!/bin/sh
# pre-commit — (1) bloqueia commit na main  (2) registra "trabalhou" em PRESENCA.md
#
# Versao versionada: .git/hooks NAO e clonado pelo git, entao o hook so existe se
# alguem rodar o setup. Este arquivo vive no repo e e ativado por
#   git config core.hooksPath hooks
# (feito por setup.sh / scripts/agente.sh).
set -u
R=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
b=$(git branch --show-current 2>/dev/null || echo "")

if [ "$b" = main ] && [ -z "${OK:-}" ]; then
  echo "main: use git switch -c PROJETO (ou OK=1)"
  exit 1
fi


# PLANO.md e a resposta do lead. Agente que escreve nele sem ser o lead destrói a
# unica direcao que os outros leem. Recusa antes de gravar.
if [ -z "${LEAD:-}" ] && git diff --cached --name-only | grep -qx 'PLANO.md'; then
  echo "PLANO.md pertence ao tech lead. Escreva na branch relatorio (scripts/relatorio.sh);"
  echo "se voce E o lead deste turno, assuma explicitamente: LEAD=1 git commit ..."
  exit 1
fi


exit 0
